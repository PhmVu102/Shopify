# Shopify App Configuration
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=https://your-app-tunnel-url.trycloudflare.com
SCOPES=read_products

# Database Configuration (SQLite default via Prisma)
DATABASE_URL="file:dev.sqlite"
PRISMA_CLIENT_ENGINE_TYPE=binary

# Embedding & AI Configuration
# Tùy chọn: Nhập OpenAI API key để sử dụng model text-embedding-3-small (1536 dims).
# Nếu không điền, hệ thống sẽ tự động dùng Local Semantic Projection Provider an toàn không crash app.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Port & Server Environment
PORT=3000
NODE_ENV=development
